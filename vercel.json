{
  "$schema": "https://openapi.vercel.sh/vercel.schema.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public/build" }
    },
    {
      "src": "public/customerdesign/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.{png,jpg,jpeg,gif,svg,ico,webp,css,txt}",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.4"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/customerdesign/(.*)", "dest": "/public/customerdesign/$1" },
    { "src": "/(favicon\\.ico|robots\\.txt|bootstrap\\.min\\.css)", "dest": "/public/$1" },
    { "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
